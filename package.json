{
  "name": "bloxwap-sfx-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run docs:dev",
    "build": "npm --workspace @bloxwap/sfx run build",
    "test": "npm --workspace @bloxwap/sfx run test",
    "coverage": "npm --workspace @bloxwap/sfx run coverage",
    "typecheck": "npm --workspace @bloxwap/sfx run typecheck",
    "build:tsc": "npm --workspace @bloxwap/sfx run build:tsc",
    "typecheck:tsc": "npm --workspace @bloxwap/sfx run typecheck:tsc",
    "bench": "npm --workspace @bloxwap/sfx run bench",
    "size": "npm --workspace @bloxwap/sfx run size",
    "docs:dev": "npm --workspace @bloxwap/sfx-docs run dev",
    "docs:build": "npm --workspace @bloxwap/sfx-docs run build",
    "docs:check": "npm --workspace @bloxwap/sfx-docs run check",
    "docs:check:tsc": "npm --workspace @bloxwap/sfx-docs run check:tsc",
    "docs:preview": "npm --workspace @bloxwap/sfx-docs run preview",
    "pack:sfx": "npm pack --workspace @bloxwap/sfx --pack-destination packages/sfx",
    "coverage:lcov": "npm --workspace @bloxwap/sfx run coverage:lcov",
    "test:browser": "npm --workspace @bloxwap/sfx run test:browser --",
    "smoke:registry": "npm --workspace @bloxwap/sfx run smoke:registry --",
    "docs:smoke": "npm --workspace @bloxwap/sfx-docs run smoke --",
    "export:hig": "npm run build && node packages/sfx/scripts/export-approved.ts",
    "lint": "eslint packages/sfx/src apps/docs/components"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
