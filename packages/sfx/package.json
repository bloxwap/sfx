{
  "name": "@bloxwap/sfx",
  "version": "0.4.0",
  "description": "Interface sound effects for the web and React Native from one set of recipes: synthesized live with Web Audio on the web, played from baked PCM by a tiny Expo module on iOS and Android. Zero runtime JS dependencies.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/sfx.git",
    "directory": "packages/sfx"
  },
  "homepage": "https://bloxwap.github.io/sfx/",
  "bugs": {
    "url": "https://github.com/bloxwap/sfx/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/native.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/native.js",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    },
    "./wav": {
      "types": "./dist/wav.d.ts",
      "import": "./dist/wav.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "react-native": "./dist/react.native.js",
      "import": "./dist/react.js"
    },
    "./semantic": {
      "types": "./dist/semantic.d.ts",
      "import": "./dist/semantic.js"
    },
    "./assets/hig/*": "./assets/hig/*"
  },
  "bin": {
    "sfx-wav": "./dist/cli/sfx-wav.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "assets/hig",
    "native/assets",
    "ios",
    "android/build.gradle",
    "android/src",
    "BloxwapSfx.podspec",
    "expo-module.config.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && node scripts/tsc-or-tsrs.mjs -p tsconfig.json && node scripts/tsc-or-tsrs.mjs -p tsconfig.cli.json",
    "typecheck": "npm run build && node scripts/tsc-or-tsrs.mjs -p tsconfig.dev.json",
    "build:tsc": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cli.json",
    "typecheck:tsc": "npm run build:tsc && tsc -p tsconfig.dev.json",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "coverage": "npm run build && node --enable-source-maps --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='src/cli/sfx-wav.ts' --test-coverage-exclude='**/node_modules/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"test/**/*.test.ts\"",
    "bench": "npm run build && node bench/schedule.bench.ts",
    "size": "npm run build && node scripts/size.ts",
    "bake:native": "npm run build && node scripts/bake-native.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "coverage:lcov": "npm run build && node -e \"require('node:fs').mkdirSync('coverage', {recursive:true})\" && node --enable-source-maps --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='src/cli/sfx-wav.ts' --test-coverage-exclude='**/node_modules/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"test/**/*.test.ts\"",
    "test:browser": "npm run build && playwright test",
    "smoke:registry": "node scripts/registry-smoke.ts",
    "bench:perf": "npm run build && node bench/perf/run-all.ts",
    "test:native": "node scripts/test-native.ts"
  },
  "keywords": [
    "web-audio",
    "sound",
    "sfx",
    "ui-sounds",
    "sound-effects",
    "interaction-feedback",
    "interface-sounds",
    "hover",
    "click",
    "synthesis",
    "react-native",
    "expo",
    "ios",
    "android"
  ],
  "peerDependencies": {
    "node-web-audio-api": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "expo": ">=52"
  },
  "peerDependenciesMeta": {
    "node-web-audio-api": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "node-web-audio-api": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
