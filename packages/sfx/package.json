{
  "name": "@bloxwap/sfx",
  "version": "0.1.0",
  "description": "Interface sound effects for the web, synthesized live with Web Audio. No audio files, zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/sfx.git",
    "directory": "packages/sfx"
  },
  "homepage": "https://bloxwap.github.io/sfx/",
  "bugs": {
    "url": "https://github.com/bloxwap/sfx/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    },
    "./wav": {
      "types": "./dist/wav.d.ts",
      "import": "./dist/wav.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "bin": {
    "sfx-wav": "./dist/cli/sfx-wav.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cli.json",
    "typecheck": "npm run build && tsc -p tsconfig.dev.json",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "coverage": "npm run build && node --enable-source-maps --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='src/cli/sfx-wav.ts' --test-coverage-exclude='**/node_modules/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"test/**/*.test.ts\"",
    "bench": "npm run build && node bench/schedule.bench.ts",
    "size": "npm run build && node scripts/size.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "coverage:lcov": "npm run build && node -e \"require('node:fs').mkdirSync('coverage', {recursive:true})\" && node --enable-source-maps --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='src/cli/sfx-wav.ts' --test-coverage-exclude='**/node_modules/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 \"test/**/*.test.ts\"",
    "test:browser": "npm run build && playwright test",
    "smoke:registry": "node scripts/registry-smoke.ts"
  },
  "keywords": [
    "web-audio",
    "sound",
    "sfx",
    "ui-sounds",
    "sound-effects",
    "interaction-feedback",
    "interface-sounds",
    "hover",
    "click",
    "synthesis"
  ],
  "peerDependencies": {
    "node-web-audio-api": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "node-web-audio-api": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "node-web-audio-api": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
